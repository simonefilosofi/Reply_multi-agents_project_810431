      "equivalent_python": "df[\"comparto\"] = df[\"comparto\"].replace({'ND': None, '--': None})\nlookup = imputation_hints[\"comparto\"][\"mapping\"]\npredictor = imputation_hints[\"comparto\"][\"predictor_columns\"][0]\ndf[\"comparto\"] = df[\"comparto\"].fillna(df[predictor].astype(\"string\").map(lookup))",
